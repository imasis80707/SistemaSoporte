@model IEnumerable<Web.Models.EtiquetaVm>

@{
    ViewData["Title"] = "Etiquetas";
}

<h1>Etiquetas</h1>

<p>
    <a asp-action="Crear">Nueva etiqueta</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Color)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Color)
            </td>
            <td>
                <a asp-action="Detalle" asp-route-id="@item.Id">Ver</a>
            </td>
        </tr>
}
    </tbody>
</table>
